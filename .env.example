# By default Nomad uses a local SQLite database in .data/nomad.db.
# Override this for another database, for example:
# DATABASE_URL=postgresql+pg8000://user:password@host:5432/database
DATABASE_URL=
DATA_DIR=.data
APP_ENV=development
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=Nomad/0.3 (personal travel memory application)
# Google OAuth (create a Web application in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nomad.alwaysdata.net/auth/google/callback
